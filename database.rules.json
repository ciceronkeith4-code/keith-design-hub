{
  "rules": {
    "presence": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "$connection": {
          ".validate": "newData.hasChild('at') && newData.child('at').isNumber()",
          "at": { ".validate": "newData.isNumber()" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "avatar": { ".validate": "newData.isString() && newData.val().beginsWith('https://') && newData.val().length <= 500" },
          "$other": { ".validate": false }
        }
      }
    },
    "likes": {
      "total": {
        ".read": true,
        ".write": "auth != null && newData.val() === (data.exists() ? data.val() + 1 : 1) && newData.parent().child('visitors').child(auth.uid).val() === now && (!data.parent().child('visitors').child(auth.uid).exists() || data.parent().child('visitors').child(auth.uid).val() < now - 86400000)",
        ".validate": "newData.isNumber()"
      },
      "visitors": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && newData.val() === now && (!data.exists() || data.val() < now - 86400000)",
          ".validate": "newData.isNumber()"
        }
      },
      "$other": { ".validate": false }
    },
    "guestbook": {
      ".read": true,
      ".indexOn": ["at"],
      "$uid": {
        ".write": "auth != null && ((auth.uid === $uid && (auth.token.firebase.sign_in_provider === 'google.com' || auth.token.firebase.sign_in_provider === 'facebook.com')) || (!newData.exists() && auth.token.email === 'ciceronkeith4@gmail.com' && auth.token.email_verified === true))",
        ".validate": "newData.hasChildren(['message', 'at'])",
        "message": { ".validate": "newData.isString() && newData.val().length <= 140 && newData.val().matches(/^\\s*\\S.*$/)" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 100 && newData.val() === auth.token.name" },
        "avatar": { ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().matches(/^https:\\/\\/lh[0-9]+\\.googleusercontent\\.com\\/.*$/)" },
        "at": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    },
    "pins": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.token.email === 'ciceronkeith4@gmail.com' && auth.token.email_verified === true",
        ".validate": "newData.isNumber()"
      }
    },
    "$other": { ".read": false, ".write": false }
  }
}
