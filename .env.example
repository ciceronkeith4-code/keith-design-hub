# Copy to .env.local for local development. On Vercel, add the same names under
# Project Settings > Environment Variables. Never commit real values.

# --- "Ask about Keith" assistant (server only: no VITE_ prefix, so it never reaches the browser) ---
# A free key from https://aistudio.google.com/apikey (Google account, no card needed).
# Free limits are per Google Cloud PROJECT, not per key, so create this key in a NEW project if you also run
# another app (such as Kabisadeck) on a free key, or the two will share one small daily quota.
GEMINI_API_KEY=
# Optional. Comma-separated models, best first. Each has its own free daily quota; when one runs out the next is used.
CHAT_MODELS=
# Optional. Set to 1 to switch the assistant off without redeploying code.
CHAT_DISABLED=

# --- Already used by the site (see .env.local) ---
# VITE_WEB3FORMS_KEY                 contact form
# VITE_FIREBASE_API_KEY, VITE_FIREBASE_AUTH_DOMAIN, VITE_FIREBASE_DATABASE_URL,
# VITE_FIREBASE_PROJECT_ID, VITE_FIREBASE_APP_ID   viewers list, likes, guestbook
